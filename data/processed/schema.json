{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Climate Impact Calculator Data Row",
  "type": "object",
  "required": [
    "item_id",
    "category",
    "unit_action",
    "low_wh",
    "mid_wh",
    "high_wh",
    "water_low_ml",
    "water_mid_ml",
    "water_high_ml",
    "source_url",
    "source_date",
    "confidence"
  ],
  "properties": {
    "item_id": { "type": "string" },
    "category": {
      "type": "string",
      "enum": ["text_inference", "image_inference", "video_inference", "training", "comparator"]
    },
    "unit_action": { "type": "string" },
    "low_wh": { "type": "number", "minimum": 0 },
    "mid_wh": { "type": "number", "minimum": 0 },
    "high_wh": { "type": "number", "minimum": 0 },
    "water_low_ml": { "type": "number", "minimum": 0 },
    "water_mid_ml": { "type": "number", "minimum": 0 },
    "water_high_ml": { "type": "number", "minimum": 0 },
    "source_url": { "type": "string", "format": "uri" },
    "source_date": { "type": "string", "format": "date" },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "notes": { "type": "string" }
  }
}
